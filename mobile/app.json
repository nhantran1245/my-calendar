{
  "expo": {
    "name": "My Calendar",
    "slug": "my-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mycalendar",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.personal.mycalendar",
      "supportsTablet": true
    },
    "android": {
      "package": "com.personal.mycalendar",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7f1913dc-4489-4d33-be4b-6fbe793951c3"
      }
    },
    "owner": "nhantran1245"
  }
}
